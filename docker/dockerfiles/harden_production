FROM node:20-alpine
RUN apk add --no-cache curl
WORKDIR /app

# Production dependencies only
COPY --chown=node:node package*.json ./
RUN npm ci --omit=dev
COPY --chown=node:node . .

USER node

HEALTHCHECK --interval=30s --timeout=3s \
  CMD curl -f http://localhost:3000/healthz || exit 1

EXPOSE 3000
CMD [ "node", "server.js" ]
